{
  "name": "agileandco",
  "version": "0.1.0",
  "type": "module",
  "description": "An online board game where you manage an agile software development company and lead your teams to success.",
  "main": "index.js",
  "scripts": {
    "dev:mockups": "BUILD_TARGET=mockups vite --config config/vite.config.ts",
    "dev:website": "npm run copy-banners-dev && BUILD_TARGET=website vite --config config/vite.config.ts",
    "dev:banner": "BUILD_TARGET=banner vite --config config/vite.config.ts",
    "build:mockups": "BUILD_TARGET=mockups vite build --config config/vite.config.ts && npm run copy-mockups",
    "build:website": "BUILD_TARGET=website vite build --config config/vite.config.ts && npm run copy-website",
    "build:bga": "BUILD_TARGET=bga vite build --config config/vite.config.ts && npm run copy-backend && npm run copy-frontend && npm run copy-banners-prod",
    "check": "svelte-check --tsconfig ./config/tsconfig.json",
    "copy-mockups": "copyfiles -u 3 'frontend/explorations/deploy/index.html' local/standalone",
    "copy-website": "copyfiles -u 3 'frontend/website/deploy/{index,print}.html' local/website",
    "copy-backend": "copyfiles -u 2 'backend/config/*' remote && copyfiles -u 2 -f 'backend/src/**/*' remote/modules/php",
    "copy-frontend": "copyfiles -u 1 'frontend/agileandco.js' remote",
    "generate-banner": "node --loader ts-node/esm frontend/shared/banner/generate.ts",
    "copy-banners-dev": "npm run generate-banner && copyfiles -u 4 'frontend/shared/banner/output/*.jpg' frontend/website/public",
    "copy-banners-prod": "npm run generate-banner && copyfiles -u 4 'frontend/shared/banner/output/*.jpg' local/website/public",
    "test": "vitest --config ./config/vitest.config.ts"
  },
  "devDependencies": {
    "@nubolab-ffwd/svelte-fluent": "^1.0.3",
    "@playwright/test": "^1.42.1",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^22.10.3",
    "@vitest/coverage-v8": "^3.1.4",
    "copyfiles": "^2.4.1",
    "sass": "^1.83.0",
    "svelte": "^5.16.0",
    "svelte-check": "^4.1.1",
    "svelte-preprocess": "^6.0.3",
    "typescript": "~5.6.2",
    "vite": "^6.0.6",
    "vitest": "^3.1.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Oaz/AgileAndCo.git"
  },
  "private": true,
  "dependencies": {
    "@playwright/test": "^1.52.0",
    "@rollup/plugin-image": "^3.0.3",
    "svelte-spa-router": "^4.0.1",
    "vite-plugin-svgr": "^4.3.0"
  }
}
